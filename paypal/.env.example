# Offline is the default; this example is never auto-loaded.
GHOST_CHECKOUT_MODE=offline
GHOST_CHECKOUT_PORT=8876
# Sandbox reads an external owner-owned 0600 file, never this example.
# GHOST_CHECKOUT_SECRETS defaults to ~/.config/ghostfirst/paypal.env
# Required external file names; leave every value blank here:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SANDBOX_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
