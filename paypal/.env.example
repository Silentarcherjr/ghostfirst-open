# E1–E5: runtime refuses all live modes and does NOT read credential files.
GHOST_CHECKOUT_MODE=offline
GHOST_CHECKOUT_PORT=8876
# Reserved for E6, after review/authorization. Leave blank; never commit values.
# Secrets will live at ~/.config/ghostfirst/paypal.env, not in this project.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Public fixture placeholders, not real IDs or credentials:
SANDBOX_CLIENT_ID=MOCK_CLIENT
SANDBOX_MERCHANT_ID=DEMO_BAKERY_MERCHANT
